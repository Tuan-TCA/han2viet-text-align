  "projected_separate": [
    {
      "text_api": "X7寬政辭磨，但見盡抗武功誕字之德；奸雄華偃於華面，顏傳正馬之牧邊；偽岳徒釐亦來障永絕三苗之員，固率卡共道，南北同輪。",
      "global_raw_span": [
        0,
        52
      ]
    },
    {
      "text_api": "小生不勝貯望屏嘗之至。",
      "global_raw_span": [
        52,
        62
      ]
    },
    {
      "text_api": "謹章。",
      "global_raw_span": [
        62,
        64
      ]
    },
    {
      "text_api": "撫邊雜錄卷之六物產之美多出獻方圓化北市政卅七十五社村坊外出人參義樂白蜜黃蠟犀角象牙兒角硝硝絳香缺藤竟藤烏木秩林花楊花、冕木、唐木之煩。",
      "global_raw_span": [
        64,
        128
      ]
    },
    {
      "text_api": "北制政源頭有屹木，亦名田木花白而撮貳，久見潮黃，屈之不折，可為弩臂。",
      "global_raw_span": [
        128,
        157
      ]
    },
    {
      "text_api": "北制政桑樓密，膏亦清振，其木非桑也。",
      "global_raw_span": [
        157,
        172
      ]
    },
    {
      "text_api": "樹似粘子涉參，葉似金鳳，殘倍其实。",
      "global_raw_span": [
        172,
        186
      ]
    },
    {
      "text_api": "正月熟，弥漫林藏，生食闕甘，土人煎密1。",
      "global_raw_span": [
        186,
        202
      ]
    }
  ],
