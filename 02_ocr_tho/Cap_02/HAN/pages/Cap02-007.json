{"info": {"cap": "Cap_02", "page": 7, "detected": 16, "kept": 16, "removed": [], "proposed": [], "status": "OK", "edge_features": {}, "ranges_rtl": [[1708, 1800], [1614, 1706], [1520, 1612], [1421, 1513], [1326, 1418], [1231, 1323], [1134, 1226], [1033, 1125], [906, 999], [814, 906], [717, 811], [615, 709], [519, 613], [422, 516], [325, 419], [232, 325]], "detector": "spacing", "angle": 0.0, "hough": null, "gain": 0.0, "deskew_status": "not_applied"}, "rows": [{"id": "Cap02-007-001", "han": "義之資而忘其終以獲利之自得矣尊言惡之權括群寇之", "confidence": 0.8039032220840454, "cap": "Cap_02", "page": 7, "segment": 1, "column": "Cap02-007-COL01"}, {"id": "Cap02-007-002", "han": "藏", "confidence": 0.32774195075035095, "cap": "Cap_02", "page": 7, "segment": 2, "column": "Cap02-007-COL02"}, {"id": "Cap02-007-003", "han": "玩族舜潛之珠以供一瓶亦斯為薄文夫何有於反嘗焉古之", "confidence": 0.7915918231010437, "cap": "Cap_02", "page": 7, "segment": 3, "column": "Cap02-007-COL02"}, {"id": "Cap02-007-004", "han": "為孝也牽道丘以為肉碩力開以為閩偏百行而虛屋之集", "confidence": 0.7462525367736816, "cap": "Cap_02", "page": 7, "segment": 4, "column": "Cap02-007-COL03"}, {"id": "Cap02-007-005", "han": "夢善而對服云言可言於可言之辰無不中為可為於", "confidence": 0.8264775276184082, "cap": "Cap_02", "page": 7, "segment": 5, "column": "Cap02-007-COL04"}, {"id": "Cap02-007-006", "han": "可為之辰無不從修之於家而鳴之於王遠修之於國而", "confidence": 0.8725460171699524, "cap": "Cap_02", "page": 7, "segment": 6, "column": "Cap02-007-COL05"}, {"id": "Cap02-007-007", "han": "行之於絕為其如是之又得鄙也則不然采之於翰墨", "confidence": 0.7514073252677917, "cap": "Cap_02", "page": 7, "segment": 7, "column": "Cap02-007-COL06"}, {"id": "Cap02-007-008", "han": "之微而加之於吏民之上錄於資蔭之末而貴以發邊之放", "confidence": 0.8003728985786438, "cap": "Cap_02", "page": 7, "segment": 8, "column": "Cap02-007-COL07"}, {"id": "Cap02-007-009", "han": "則何等榮遇何等辰節哉苟卻之徒慕黃公之盛方其所", "confidence": 0.6805648803710938, "cap": "Cap_02", "page": 7, "segment": 9, "column": "Cap02-007-COL08"}, {"id": "Cap02-007-010", "han": "以廣也非克善南仲之金師其所以金也弗堯清三表五", "confidence": 0.7365968227386475, "cap": "Cap_02", "page": 7, "segment": 10, "column": "Cap02-007-COL09"}, {"id": "Cap02-007-011", "han": "餅之良紫魯中说免期月三年之效茫若望洋出入膠", "confidence": 0.7785471677780151, "cap": "Cap_02", "page": 7, "segment": 11, "column": "Cap02-007-COL10"}, {"id": "Cap02-007-012", "han": "接進退如觸買侯而藏以鄙也為亡有得乎笑中之因", "confidence": 0.7245694398880005, "cap": "Cap_02", "page": 7, "segment": 12, "column": "Cap02-007-COL11"}, {"id": "Cap02-007-013", "han": "也必無外而弗回赫之行也必無疏而葬至鄙也同卷人之而", "confidence": 0.8556968569755554, "cap": "Cap_02", "page": 7, "segment": 13, "column": "Cap02-007-COL12"}, {"id": "Cap02-007-014", "han": "乃如三因乃四之行皆賢侯之不定見之匪惟誠鉴將不知", "confidence": 0.6823911666870117, "cap": "Cap_02", "page": 7, "segment": 14, "column": "Cap02-007-COL13"}, {"id": "Cap02-007-015", "han": "五行不說一丁亦藥見其無臣也已買候而又以鄙也五生", "confidence": 0.7595531344413757, "cap": "Cap_02", "page": 7, "segment": 15, "column": "Cap02-007-COL14"}, {"id": "Cap02-007-016", "han": "真得守無然人不亡離道義人道亦不能遠人以為道", "confidence": 0.7037394642829895, "cap": "Cap_02", "page": 7, "segment": 16, "column": "Cap02-007-COL15"}, {"id": "Cap02-007-017", "han": "事本乎道之著於事天生人人成天位定然無定形分之", "confidence": 0.7244179248809814, "cap": "Cap_02", "page": 7, "segment": 17, "column": "Cap02-007-COL16"}], "text": "義之資而忘其終以獲利之自得矣尊言惡之權括群寇之藏玩族舜潛之珠以供一瓶亦斯為薄文夫何有於反嘗焉古之為孝也牽道丘以為肉碩力開以為閩偏百行而虛屋之集夢善而對服云言可言於可言之辰無不中為可為於可為之辰無不從修之於家而鳴之於王遠修之於國而行之於絕為其如是之又得鄙也則不然采之於翰墨之微而加之於吏民之上錄於資蔭之末而貴以發邊之放則何等榮遇何等辰節哉苟卻之徒慕黃公之盛方其所以廣也非克善南仲之金師其所以金也弗堯清三表五餅之良紫魯中说免期月三年之效茫若望洋出入膠接進退如觸買侯而藏以鄙也為亡有得乎笑中之因也必無外而弗回赫之行也必無疏而葬至鄙也同卷人之而乃如三因乃四之行皆賢侯之不定見之匪惟誠鉴將不知五行不說一丁亦藥見其無臣也已買候而又以鄙也五生真得守無然人不亡離道義人道亦不能遠人以為道事本乎道之著於事天生人人成天位定然無定形分之"}