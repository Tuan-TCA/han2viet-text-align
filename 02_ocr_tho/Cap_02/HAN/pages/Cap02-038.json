{"info": {"cap": "Cap_02", "page": 38, "detected": 16, "kept": 16, "removed": [], "proposed": [], "status": "OK", "edge_features": {}, "ranges_rtl": [[1686, 1780], [1592, 1686], [1496, 1590], [1396, 1490], [1299, 1393], [1205, 1299], [1108, 1202], [1009, 1103], [882, 974], [785, 877], [689, 781], [594, 686], [494, 586], [397, 489], [301, 393], [207, 299]], "detector": "spacing", "angle": 0.0, "hough": null, "gain": 0.0, "deskew_status": "not_applied"}, "rows": [{"id": "Cap02-038-001", "han": "臣堯去已私以至產買地位也今人多以言语不臣屈服", "confidence": 0.7816731929779053, "cap": "Cap_02", "page": 38, "segment": 1, "column": "Cap02-038-COL01"}, {"id": "Cap02-038-002", "han": "得人意無不亡凌乱得人憤怨嘗欲不忘直意用法", "confidence": 0.7503344416618347, "cap": "Cap_02", "page": 38, "segment": 2, "column": "Cap02-038-COL02"}, {"id": "Cap02-038-003", "han": "無耻夫不知此乃孝者之為止君子之所宜深耻者古之大", "confidence": 0.8797414302825928, "cap": "Cap_02", "page": 38, "segment": 3, "column": "Cap02-038-COL03"}, {"id": "Cap02-038-004", "han": "臣更不称便智谋才畧只是一个妨三乎無他枝休之有容", "confidence": 0.7794104814529419, "cap": "Cap_02", "page": 38, "segment": 4, "column": "Cap02-038-COL04"}, {"id": "Cap02-038-005", "han": "而已孝者須是克去已私直至得所之休之休隱方亡康", "confidence": 0.7350643277168274, "cap": "Cap_02", "page": 38, "segment": 5, "column": "Cap02-038-COL05"}, {"id": "Cap02-038-006", "han": "請得天下拖回三代之治方是不員吾君不枉此出世一", "confidence": 0.8611940145492554, "cap": "Cap_02", "page": 38, "segment": 6, "column": "Cap02-038-COL06"}, {"id": "Cap02-038-007", "han": "嘗遇也吳世璘又有佛錄弊一劄兌福淳不之省其言", "confidence": 0.8160285949707031, "cap": "Cap_02", "page": 38, "segment": 7, "column": "Cap02-038-COL07"}, {"id": "Cap02-038-008", "han": "曰窃闻自先君啟字地尚狹艮尚稀南未有知定之地", "confidence": 0.8194106221199036, "cap": "Cap_02", "page": 38, "segment": 8, "column": "Cap02-038-COL08"}, {"id": "Cap02-038-009", "han": "北尚有橫山之攬黎專年兵華而民無飢璧國有餘焉", "confidence": 0.7259732484817505, "cap": "Cap_02", "page": 38, "segment": 9, "column": "Cap02-038-COL09"}, {"id": "Cap02-038-010", "han": "今天下承平日久地廣民藩生穀之土已尽蠻山澤之", "confidence": 0.8284626007080078, "cap": "Cap_02", "page": 38, "segment": 10, "column": "Cap02-038-COL10"}, {"id": "Cap02-038-011", "han": "利已尽出加之以為宏龍湖之田又無天災焦潦之亥無", "confidence": 0.7058120369911194, "cap": "Cap_02", "page": 38, "segment": 11, "column": "Cap02-038-COL11"}, {"id": "Cap02-038-012", "han": "終自成子以來業價隱孺莽臣飢璧其故傳素臣窃忠", "confidence": 0.6369478106498718, "cap": "Cap_02", "page": 38, "segment": 12, "column": "Cap02-038-COL12"}, {"id": "Cap02-038-013", "han": "非柔之少也在鉛錢之所致也夫民之勢利獨小之能下", "confidence": 0.757506787776947, "cap": "Cap_02", "page": 38, "segment": 13, "column": "Cap02-038-COL13"}, {"id": "Cap02-038-014", "han": "其葉不可過故雖深山有瘴煙之毒虎狼之惡大恣有", "confidence": 0.75621098279953, "cap": "Cap_02", "page": 38, "segment": 14, "column": "Cap02-038-COL14"}, {"id": "Cap02-038-015", "han": "此波之險鯨雖之暴而人常履之而不畏者見其利而忘", "confidence": 0.8672208786010742, "cap": "Cap_02", "page": 38, "segment": 15, "column": "Cap02-038-COL15"}, {"id": "Cap02-038-016", "han": "其害也况鑄鉛錢之利其利要倍於他而無產烟虎狼", "confidence": 0.7157050967216492, "cap": "Cap_02", "page": 38, "segment": 16, "column": "Cap02-038-COL16"}], "text": "臣堯去已私以至產買地位也今人多以言语不臣屈服得人意無不亡凌乱得人憤怨嘗欲不忘直意用法無耻夫不知此乃孝者之為止君子之所宜深耻者古之大臣更不称便智谋才畧只是一个妨三乎無他枝休之有容而已孝者須是克去已私直至得所之休之休隱方亡康請得天下拖回三代之治方是不員吾君不枉此出世一嘗遇也吳世璘又有佛錄弊一劄兌福淳不之省其言曰窃闻自先君啟字地尚狹艮尚稀南未有知定之地北尚有橫山之攬黎專年兵華而民無飢璧國有餘焉今天下承平日久地廣民藩生穀之土已尽蠻山澤之利已尽出加之以為宏龍湖之田又無天災焦潦之亥無終自成子以來業價隱孺莽臣飢璧其故傳素臣窃忠非柔之少也在鉛錢之所致也夫民之勢利獨小之能下其葉不可過故雖深山有瘴煙之毒虎狼之惡大恣有此波之險鯨雖之暴而人常履之而不畏者見其利而忘其害也况鑄鉛錢之利其利要倍於他而無產烟虎狼"}