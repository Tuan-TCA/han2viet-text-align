{"info": {"cap": "Cap_02", "page": 39, "detected": 16, "kept": 16, "removed": [], "proposed": [], "status": "OK", "edge_features": {}, "ranges_rtl": [[1685, 1779], [1591, 1685], [1497, 1591], [1397, 1491], [1299, 1393], [1206, 1299], [1109, 1203], [1008, 1102], [881, 975], [787, 881], [686, 780], [591, 685], [493, 587], [393, 487], [298, 390], [207, 298]], "detector": "spacing", "angle": 0.0, "hough": null, "gain": 0.0, "deskew_status": "not_applied"}, "rows": [{"id": "Cap02-039-001", "han": "尾波棘鑑之患權有法禁然而自用錢以來未是並錫", "confidence": 0.6802316308021545, "cap": "Cap_02", "page": 39, "segment": 1, "column": "Cap02-039-COL01"}, {"id": "Cap02-039-002", "han": "趙而死者故自巴志盜勢鉛新之好行而嘉宏之案", "confidence": 0.6855589151382446, "cap": "Cap_02", "page": 39, "segment": 2, "column": "Cap02-039-COL02"}, {"id": "Cap02-039-003", "han": "價騰號善盜謠鉛寶去得利之富若載之他處恐漏", "confidence": 0.6949406862258911, "cap": "Cap_02", "page": 39, "segment": 3, "column": "Cap02-039-COL03"}, {"id": "Cap02-039-004", "han": "其奸故不計貨之貴則皆隨而買之粟價遂因之而貴", "confidence": 0.8298963904380798, "cap": "Cap_02", "page": 39, "segment": 4, "column": "Cap02-039-COL04"}, {"id": "Cap02-039-005", "han": "案貴則人民畏飢畏飢則爭買而積爭積且衆日益", "confidence": 0.8176597356796265, "cap": "Cap_02", "page": 39, "segment": 5, "column": "Cap02-039-COL05"}, {"id": "Cap02-039-006", "han": "貴案貴則天下之物皆隨而貴焉泥人情誰不當坚", "confidence": 0.7889724969863892, "cap": "Cap_02", "page": 39, "segment": 6, "column": "Cap02-039-COL06"}, {"id": "Cap02-039-007", "han": "牢而嫌易敗令以招新之易敗而當銅寶之星年所以", "confidence": 0.7568793892860413, "cap": "Cap_02", "page": 39, "segment": 7, "column": "Cap02-039-COL07"}, {"id": "Cap02-039-008", "han": "民爭積案而不肯禮錢也美良帝辰獵秦封而之", "confidence": 0.606573224067688, "cap": "Cap_02", "page": 39, "segment": 8, "column": "Cap02-039-COL08"}, {"id": "Cap02-039-009", "han": "重更勝家詠物價騰號米石步孫此諸薄致案貴院", "confidence": 0.6133301258087158, "cap": "Cap_02", "page": 39, "segment": 9, "column": "Cap02-039-COL09"}, {"id": "Cap02-039-010", "han": "有明卧矣且自有知宏民在此處者未嘗以積粟己利", "confidence": 0.7660500407218933, "cap": "Cap_02", "page": 39, "segment": 10, "column": "Cap02-039-COL10"}, {"id": "Cap02-039-011", "han": "今為室府家之皆積案不特嘉室令富春及諸府不", "confidence": 0.7826166749000549, "cap": "Cap_02", "page": 39, "segment": 11, "column": "Cap02-039-COL11"}, {"id": "Cap02-039-012", "han": "海貴賤自農有孫去皆相爭而種業而使案之不貴", "confidence": 0.7222107648849487, "cap": "Cap_02", "page": 39, "segment": 12, "column": "Cap02-039-COL12"}, {"id": "Cap02-039-013", "han": "其可得宋翁室貴案即法府之案不得不貴諸府之", "confidence": 0.7336803674697876, "cap": "Cap_02", "page": 39, "segment": 13, "column": "Cap02-039-COL13"}, {"id": "Cap02-039-014", "han": "粟貴且富春之民不飢去幾希矣夫人情一日不再食", "confidence": 0.7366763353347778, "cap": "Cap_02", "page": 39, "segment": 14, "column": "Cap02-039-COL14"}, {"id": "Cap02-039-015", "han": "且飢終矣不製衣則氣亂實切身不廣意耻故奸邪", "confidence": 0.570895791053772, "cap": "Cap_02", "page": 39, "segment": 15, "column": "Cap02-039-COL15"}, {"id": "Cap02-039-016", "han": "日起而盜財日生语云一朝不食父子無義父不亡保其", "confidence": 0.8724809885025024, "cap": "Cap_02", "page": 39, "segment": 16, "column": "Cap02-039-COL16"}], "text": "尾波棘鑑之患權有法禁然而自用錢以來未是並錫趙而死者故自巴志盜勢鉛新之好行而嘉宏之案價騰號善盜謠鉛寶去得利之富若載之他處恐漏其奸故不計貨之貴則皆隨而買之粟價遂因之而貴案貴則人民畏飢畏飢則爭買而積爭積且衆日益貴案貴則天下之物皆隨而貴焉泥人情誰不當坚牢而嫌易敗令以招新之易敗而當銅寶之星年所以民爭積案而不肯禮錢也美良帝辰獵秦封而之重更勝家詠物價騰號米石步孫此諸薄致案貴院有明卧矣且自有知宏民在此處者未嘗以積粟己利今為室府家之皆積案不特嘉室令富春及諸府不海貴賤自農有孫去皆相爭而種業而使案之不貴其可得宋翁室貴案即法府之案不得不貴諸府之粟貴且富春之民不飢去幾希矣夫人情一日不再食且飢終矣不製衣則氣亂實切身不廣意耻故奸邪日起而盜財日生语云一朝不食父子無義父不亡保其"}