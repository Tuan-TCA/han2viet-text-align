{"info": {"cap": "Cap_02", "page": 8, "detected": 16, "kept": 16, "removed": [], "proposed": [], "status": "OK", "edge_features": {}, "ranges_rtl": [[1704, 1796], [1612, 1704], [1517, 1609], [1419, 1511], [1324, 1416], [1227, 1319], [1131, 1223], [1034, 1126], [906, 998], [810, 902], [711, 803], [614, 706], [518, 610], [417, 509], [322, 414], [230, 322]], "detector": "spacing", "angle": 0.0, "hough": null, "gain": 0.0, "deskew_status": "not_applied"}, "rows": [{"id": "Cap02-008-001", "han": "而三木令之而六藉又人於此或卷而約之或舒而博云夫誰", "confidence": 0.7920231819152832, "cap": "Cap_02", "page": 8, "segment": 1, "column": "Cap02-008-COL01"}, {"id": "Cap02-008-002", "han": "曰不宜自人負之固故有正得有奇得之無求而不得有", "confidence": 0.8476928472518921, "cap": "Cap_02", "page": 8, "segment": 2, "column": "Cap02-008-COL02"}, {"id": "Cap02-008-003", "han": "溲", "confidence": 0.39813825488090515, "cap": "Cap_02", "page": 8, "segment": 3, "column": "Cap02-008-COL03"}, {"id": "Cap02-008-004", "han": "無注而不得道一也名之不同位之浪也昔有簡焉友善", "confidence": 0.8182592391967773, "cap": "Cap_02", "page": 8, "segment": 4, "column": "Cap02-008-COL03"}, {"id": "Cap02-008-005", "han": "進對畔而而後歧一兼者也石者薦之曰高生惠我以清人者其", "confidence": 0.6493061184883118, "cap": "Cap_02", "page": 8, "segment": 5, "column": "Cap02-008-COL04"}, {"id": "Cap02-008-006", "han": "中、汽牛酒", "confidence": 0.5585789680480957, "cap": "Cap_02", "page": 8, "segment": 6, "column": "Cap02-008-COL05"}, {"id": "Cap02-008-007", "han": "牛浪馬勃", "confidence": 0.7355440855026245, "cap": "Cap_02", "page": 8, "segment": 7, "column": "Cap02-008-COL05"}, {"id": "Cap02-008-008", "han": "永天之哉吾其永之赤藥者推之貴之以得搜數衣之", "confidence": 0.6630064845085144, "cap": "Cap_02", "page": 8, "segment": 8, "column": "Cap02-008-COL05"}, {"id": "Cap02-008-009", "han": "牛遺壽諾之養於雜夫接數之於医非可治之收之舍之於", "confidence": 0.7210333347320557, "cap": "Cap_02", "page": 8, "segment": 9, "column": "Cap02-008-COL06"}, {"id": "Cap02-008-010", "han": "馬勒", "confidence": 0.7278934717178345, "cap": "Cap_02", "page": 8, "segment": 10, "column": "Cap02-008-COL07"}, {"id": "Cap02-008-011", "han": "其位之若自翁社奉先人之貴編宿累世之精精一得意", "confidence": 0.7685348987579346, "cap": "Cap_02", "page": 8, "segment": 11, "column": "Cap02-008-COL07"}, {"id": "Cap02-008-012", "han": "商茗", "confidence": 0.22136658430099487, "cap": "Cap_02", "page": 8, "segment": 12, "column": "Cap02-008-COL08"}, {"id": "Cap02-008-013", "han": "止健第", "confidence": 0.41369327902793884, "cap": "Cap_02", "page": 8, "segment": 13, "column": "Cap02-008-COL08"}, {"id": "Cap02-008-014", "han": "則膺之不已又從而幸之而弦之曰遲吾往也院仕則弦", "confidence": 0.7416946291923523, "cap": "Cap_02", "page": 8, "segment": 14, "column": "Cap02-008-COL08"}, {"id": "Cap02-008-015", "han": "者韋三者弦斷而半矣今且不忘以一三均之是人也曾未五", "confidence": 0.7944684028625488, "cap": "Cap_02", "page": 8, "segment": 15, "column": "Cap02-008-COL09"}, {"id": "Cap02-008-016", "han": "十既胡然而其又胡德而畢似非位之級而何賈侯謙義", "confidence": 0.7068317532539368, "cap": "Cap_02", "page": 8, "segment": 16, "column": "Cap02-008-COL10"}, {"id": "Cap02-008-017", "han": "土之義復焚券之值貴為失重然诺廉秘合而應已律", "confidence": 0.6129379272460938, "cap": "Cap_02", "page": 8, "segment": 17, "column": "Cap02-008-COL11"}, {"id": "Cap02-008-018", "han": "小白之正於周勤都誠而賞罰義苑直之忠於處智微", "confidence": 0.7647085785865784, "cap": "Cap_02", "page": 8, "segment": 18, "column": "Cap02-008-COL12"}, {"id": "Cap02-008-019", "han": "為規誰使圓云義微為矩誰使能之終一言而百議終一", "confidence": 0.736372709274292, "cap": "Cap_02", "page": 8, "segment": 19, "column": "Cap02-008-COL13"}, {"id": "Cap02-008-020", "han": "行而群發且不膚挖不掣觀既而不司滿足不停報讀", "confidence": 0.7278802990913391, "cap": "Cap_02", "page": 8, "segment": 20, "column": "Cap02-008-COL14"}, {"id": "Cap02-008-021", "han": "一善而來春臺登則非鄙也之可臣得也不惟不可生恐", "confidence": 0.8039627075195312, "cap": "Cap_02", "page": 8, "segment": 21, "column": "Cap02-008-COL15"}, {"id": "Cap02-008-022", "han": "之而定不周因之而不及書者也何則涯於嘗者龍皆於", "confidence": 0.7142696380615234, "cap": "Cap_02", "page": 8, "segment": 22, "column": "Cap02-008-COL16"}], "text": "而三木令之而六藉又人於此或卷而約之或舒而博云夫誰曰不宜自人負之固故有正得有奇得之無求而不得有溲無注而不得道一也名之不同位之浪也昔有簡焉友善進對畔而而後歧一兼者也石者薦之曰高生惠我以清人者其中、汽牛酒牛浪馬勃永天之哉吾其永之赤藥者推之貴之以得搜數衣之牛遺壽諾之養於雜夫接數之於医非可治之收之舍之於馬勒其位之若自翁社奉先人之貴編宿累世之精精一得意商茗止健第則膺之不已又從而幸之而弦之曰遲吾往也院仕則弦者韋三者弦斷而半矣今且不忘以一三均之是人也曾未五十既胡然而其又胡德而畢似非位之級而何賈侯謙義土之義復焚券之值貴為失重然诺廉秘合而應已律小白之正於周勤都誠而賞罰義苑直之忠於處智微為規誰使圓云義微為矩誰使能之終一言而百議終一行而群發且不膚挖不掣觀既而不司滿足不停報讀一善而來春臺登則非鄙也之可臣得也不惟不可生恐之而定不周因之而不及書者也何則涯於嘗者龍皆於"}