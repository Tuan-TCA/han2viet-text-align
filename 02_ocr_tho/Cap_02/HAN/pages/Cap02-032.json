{"info": {"cap": "Cap_02", "page": 32, "detected": 16, "kept": 16, "removed": [], "proposed": [], "status": "OK", "edge_features": {}, "ranges_rtl": [[1710, 1802], [1619, 1710], [1524, 1618], [1424, 1518], [1323, 1416], [1231, 1323], [1130, 1224], [1032, 1126], [890, 984], [796, 890], [701, 795], [600, 694], [503, 597], [405, 499], [308, 402], [213, 307]], "detector": "spacing", "angle": 0.0, "hough": null, "gain": 0.0, "deskew_status": "not_applied"}, "rows": [{"id": "Cap02-032-001", "han": "無其質而有其柔竹之焉物者有其質而無其心故竹因尼", "confidence": 0.7995273470878601, "cap": "Cap_02", "page": 32, "segment": 1, "column": "Cap02-032-COL01"}, {"id": "Cap02-032-002", "han": "而成兹是以尾未則鳴尾去則止凡之大者見大鳴尼之小者則", "confidence": 0.6975459456443787, "cap": "Cap_02", "page": 32, "segment": 2, "column": "Cap02-032-COL02"}, {"id": "Cap02-032-003", "han": "小鳴是乃其鳴在乎尾而不在乎竹也竹之本如也至如高此", "confidence": 0.800675094127655, "cap": "Cap_02", "page": 32, "segment": 3, "column": "Cap02-032-COL03"}, {"id": "Cap02-032-004", "han": "觀淚爽必意冷隱如奔潦游口徐行珮遠夫悉亡關俗清", "confidence": 0.5096436142921448, "cap": "Cap_02", "page": 32, "segment": 4, "column": "Cap02-032-COL04"}, {"id": "Cap02-032-005", "han": "2", "confidence": 0.9997777342796326, "cap": "Cap_02", "page": 32, "segment": 5, "column": "Cap02-032-COL04"}, {"id": "Cap02-032-006", "han": "可滌頗食亦金寫而不竭者亦在乎心石妙應乎尼之雄牲", "confidence": 0.6078418493270874, "cap": "Cap_02", "page": 32, "segment": 6, "column": "Cap02-032-COL05"}, {"id": "Cap02-032-007", "han": "其所以暢發天機悠揚真韻亦在乎咱者之自得而雅醇", "confidence": 0.8058966994285583, "cap": "Cap_02", "page": 32, "segment": 7, "column": "Cap02-032-COL06"}, {"id": "Cap02-032-008", "han": "疵則於竹化無焉竹乎竹乎善有取於竹妄其一友人升華", "confidence": 0.739471435546875, "cap": "Cap_02", "page": 32, "segment": 8, "column": "Cap02-032-COL07"}, {"id": "Cap02-032-009", "han": "潤川阮蒼浩序之曰夢物主聲霧矣有出於繁元元聲者", "confidence": 0.7016519904136658, "cap": "Cap_02", "page": 32, "segment": 9, "column": "Cap02-032-COL08"}, {"id": "Cap02-032-010", "han": "天聲也繁走者人聲也故人声且有邪正之辨而天聲則無邪正", "confidence": 0.6878448724746704, "cap": "Cap_02", "page": 32, "segment": 10, "column": "Cap02-032-COL09"}, {"id": "Cap02-032-011", "han": "之小焉夫人声而求天聲之正者翕純微繹宮商安秦而", "confidence": 0.7100929617881775, "cap": "Cap_02", "page": 32, "segment": 11, "column": "Cap02-032-COL10"}, {"id": "Cap02-032-012", "han": "條理精然不錯苦笑惡焉融物成詩而性惟若得其正", "confidence": 0.6949808597564697, "cap": "Cap_02", "page": 32, "segment": 12, "column": "Cap02-032-COL11"}, {"id": "Cap02-032-013", "han": "此人之天也若其衰而至於傷步而至於淫四外上秦", "confidence": 0.8067111968994141, "cap": "Cap_02", "page": 32, "segment": 13, "column": "Cap02-032-COL12"}, {"id": "Cap02-032-014", "han": "音此人之人也至於天声托於物三司然四經世聲松志春", "confidence": 0.7676597833633423, "cap": "Cap_02", "page": 32, "segment": 14, "column": "Cap02-032-COL13"}, {"id": "Cap02-032-015", "han": "鳥声秋空聲蕉雨聲竹尾聲音韻麟魚品調暢聆之者", "confidence": 0.5801360607147217, "cap": "Cap_02", "page": 32, "segment": 15, "column": "Cap02-032-COL14"}, {"id": "Cap02-032-016", "han": "令人有野鶴之還心孤雲之喜思其孫竹繁声矣帝天", "confidence": 0.757055938243866, "cap": "Cap_02", "page": 32, "segment": 16, "column": "Cap02-032-COL15"}, {"id": "Cap02-032-017", "han": "壤者已云吾友晉江吳君完璞初習辰文老上於诗既", "confidence": 0.804703414440155, "cap": "Cap_02", "page": 32, "segment": 17, "column": "Cap02-032-COL16"}], "text": "無其質而有其柔竹之焉物者有其質而無其心故竹因尼而成兹是以尾未則鳴尾去則止凡之大者見大鳴尼之小者則小鳴是乃其鳴在乎尾而不在乎竹也竹之本如也至如高此觀淚爽必意冷隱如奔潦游口徐行珮遠夫悉亡關俗清2可滌頗食亦金寫而不竭者亦在乎心石妙應乎尼之雄牲其所以暢發天機悠揚真韻亦在乎咱者之自得而雅醇疵則於竹化無焉竹乎竹乎善有取於竹妄其一友人升華潤川阮蒼浩序之曰夢物主聲霧矣有出於繁元元聲者天聲也繁走者人聲也故人声且有邪正之辨而天聲則無邪正之小焉夫人声而求天聲之正者翕純微繹宮商安秦而條理精然不錯苦笑惡焉融物成詩而性惟若得其正此人之天也若其衰而至於傷步而至於淫四外上秦音此人之人也至於天声托於物三司然四經世聲松志春鳥声秋空聲蕉雨聲竹尾聲音韻麟魚品調暢聆之者令人有野鶴之還心孤雲之喜思其孫竹繁声矣帝天壤者已云吾友晉江吳君完璞初習辰文老上於诗既"}