{"info": {"cap": "Cap_01", "page": 51, "detected": 17, "kept": 16, "removed": [17], "proposed": [17], "status": "OK_removed_17", "edge_features": {"17": {"score": 3.0515, "tall": 1.0, "large": 0.2232, "dense_rows": 0.1179, "ink": 0.2588, "text_components": 20}}, "detector": "projection", "angle": -0.55, "hough": 1.3003977080091946, "gain": 6.257554131004103, "deskew_status": "auto"}, "rows": [{"id": "Cap01-051-001", "han": "承平之餘民心行甚搖動一旦有事別鄉何及因陳困廿四條一言府縣乃", "confidence": 0.8237693309783936, "cap": "Cap_01", "page": 51, "segment": 1, "column": "Cap01-051-COL01"}, {"id": "Cap01-051-002", "han": "親民之或北來不任川恥事不許勘同祠訟知鼎官之玩受虛名而", "confidence": 0.7114788889884949, "cap": "Cap_01", "page": 51, "segment": 2, "column": "Cap01-051-COL02"}, {"id": "Cap01-051-003", "han": "百姓之人多日受令矣其安業胡可白也乞嗣奴差餘曰四租別載別納", "confidence": 0.7831486463546753, "cap": "Cap_01", "page": 51, "segment": 3, "column": "Cap01-051-COL03"}, {"id": "Cap01-051-004", "han": "成粟稅例谷衙寓祿墻視源稅一切付炎縣緯收碉交廣南官近得以", "confidence": 0.6945170760154724, "cap": "Cap_01", "page": 51, "segment": 4, "column": "Cap01-051-COL04"}, {"id": "Cap01-051-005", "han": "免多員煩掩二觀府縣官來以勾查為高祿臣財愈耗民俗愈議", "confidence": 0.807924211025238, "cap": "Cap_01", "page": 51, "segment": 5, "column": "Cap01-051-COL05"}, {"id": "Cap01-051-006", "han": "乞定給常祿以廉貪勤怠為黜陝三記爾民有二有避役迹祖而浮", "confidence": 0.7778104543685913, "cap": "Cap_01", "page": 51, "segment": 6, "column": "Cap01-051-COL06"}, {"id": "Cap01-051-007", "han": "浪有亂安切身而流移今不分守項一切八落收稅彼必驚惶或行盜珮", "confidence": 0.7701794505119324, "cap": "Cap_01", "page": 51, "segment": 7, "column": "Cap01-051-COL07"}, {"id": "Cap01-051-008", "han": "伊社又被僕官稅民仙以堪立自今緣偏不有生理者收稅如例讥底", "confidence": 0.6922867894172668, "cap": "Cap_01", "page": 51, "segment": 8, "column": "Cap01-051-COL08"}, {"id": "Cap01-051-009", "han": "困意者仍免其稅焚方撫養以蘇穷氓四說民可使靜不可便動動則", "confidence": 0.8133467435836792, "cap": "Cap_01", "page": 51, "segment": 9, "column": "Cap01-051-COL09"}, {"id": "Cap01-051-010", "han": "易亂靜則易治今欲人畋禪山林尋雞素焉不條另意振苦生民更", "confidence": 0.766203761100769, "cap": "Cap_01", "page": 51, "segment": 10, "column": "Cap01-051-COL10"}, {"id": "Cap01-051-011", "han": "多假音之人到欠脅捉民身惡嗟乞今嗣殺差人某殺並有惡跡", "confidence": 0.7690731287002563, "cap": "Cap_01", "page": 51, "segment": 11, "column": "Cap01-051-COL11"}, {"id": "Cap01-051-012", "han": "往返呈在地方官俾得它是非真贋加有梅害及民之守便宜處", "confidence": 0.7977100610733032, "cap": "Cap_01", "page": 51, "segment": 12, "column": "Cap01-051-COL12"}, {"id": "Cap01-051-013", "han": "治或以具同兼民心安靜免致安靜搖動此疏甚吏劉切更不見从", "confidence": 0.80349200963974, "cap": "Cap_01", "page": 51, "segment": 13, "column": "Cap01-051-COL13"}, {"id": "Cap01-051-014", "han": "二十縣年果有西山之亂其言臥矣但居貞思革多員振艮之乃", "confidence": 0.8089924454689026, "cap": "Cap_01", "page": 51, "segment": 14, "column": "Cap01-051-COL14"}, {"id": "Cap01-051-015", "han": "忽委縣令徵收諸稅恐未穩當且縣官位卑權輕分微孫後姿旨一", "confidence": 0.788773775100708, "cap": "Cap_01", "page": 51, "segment": 15, "column": "Cap01-051-COL15"}, {"id": "Cap01-051-016", "han": "一辨理不如為付淡官乃為便耳", "confidence": 0.8267686367034912, "cap": "Cap_01", "page": 51, "segment": 16, "column": "Cap01-051-COL16"}], "text": "承平之餘民心行甚搖動一旦有事別鄉何及因陳困廿四條一言府縣乃親民之或北來不任川恥事不許勘同祠訟知鼎官之玩受虛名而百姓之人多日受令矣其安業胡可白也乞嗣奴差餘曰四租別載別納成粟稅例谷衙寓祿墻視源稅一切付炎縣緯收碉交廣南官近得以免多員煩掩二觀府縣官來以勾查為高祿臣財愈耗民俗愈議乞定給常祿以廉貪勤怠為黜陝三記爾民有二有避役迹祖而浮浪有亂安切身而流移今不分守項一切八落收稅彼必驚惶或行盜珮伊社又被僕官稅民仙以堪立自今緣偏不有生理者收稅如例讥底困意者仍免其稅焚方撫養以蘇穷氓四說民可使靜不可便動動則易亂靜則易治今欲人畋禪山林尋雞素焉不條另意振苦生民更多假音之人到欠脅捉民身惡嗟乞今嗣殺差人某殺並有惡跡往返呈在地方官俾得它是非真贋加有梅害及民之守便宜處治或以具同兼民心安靜免致安靜搖動此疏甚吏劉切更不見从二十縣年果有西山之亂其言臥矣但居貞思革多員振艮之乃忽委縣令徵收諸稅恐未穩當且縣官位卑權輕分微孫後姿旨一一辨理不如為付淡官乃為便耳"}